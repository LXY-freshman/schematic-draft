# No trailing slash: a bare `node_modules/` matches a directory but not a
# symlink of the same name, which is how one reached the index once.
node_modules
.pnpm-store/
.worktrees/
dist/
coverage/
playwright-report/
test-results/
output/
tmp/
*.tsbuildinfo
.vite/

# Target plans are a local working area, not a published artifact.
plan/
